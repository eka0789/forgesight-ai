# ---------------------------------------------------------------------------
# ForgeSight AI — environment template
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ---
APP_NAME=ForgeSight AI
ENV=development                # development | staging | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Local dev fallback (SQLite). Docker Compose uses PostgreSQL+pgvector below.
DATABASE_URL=sqlite:///./forgesight.db
# DATABASE_URL=postgresql+psycopg2://forgesight:forgesight@localhost:5432/forgesight

# --- Cache / rate limiting ---
REDIS_URL=redis://localhost:6379/0

# --- Storage (images / videos / documents) ---
STORAGE_BACKEND=local          # local | s3
STORAGE_DIR=./storage
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=forgesight

# --- Generative AI providers ---
# Without keys the platform runs on clearly-labeled local adapters (demo mode).
LLM_PROVIDER=mock              # mock | openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings / RAG ---
EMBEDDING_PROVIDER=local       # local | openai | huggingface
EMBEDDING_DIM=384
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- MLflow (optional; auto-detected in Docker Compose) ---
MLFLOW_TRACKING_URI=

# --- Model artifacts (trained pipelines read from here) ---
ARTIFACTS_DIR=

# --- Demo ---
SEED_DEMO=false                # seeds demo org/data on first start (clearly labeled)
